{
  "name": "@tamilcache/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "rescore": "node dist/rescore.js",
    "coverage:audit": "node dist/coverage-audit.js",
    "reclassify": "node dist/reclassify.js",
    "replay": "node dist/replay.js"
  },
  "dependencies": {
    "@tamilcache/db": "workspace:*",
    "@tamilcache/shared": "workspace:*",
    "node-cron": "3.0.3",
    "pino": "9.5.0",
    "drizzle-orm": "0.38.2"
  },
  "devDependencies": {
    "@types/node-cron": "3.0.11"
  }
}
