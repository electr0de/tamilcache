# TamilCache — every value here is optional. `docker compose up -d` works with no .env at all;
# copy this file only when you want to change a default.
#
# ─── deployment (read by docker-compose.yml) ──────────────────────────────────────────────────────
# Host directory holding the database, uploaded .torrent files and backups. Default ./data, i.e.
# beside the compose file. MUST be a local disk: SQLite WAL on a synced folder (Seafile, Dropbox,
# NFS) or an Unraid shfs volume that moves files between array disks corrupts the database.
TAMILCACHE_DATA=./data
# Host port. The container always listens on 8484 internally.
TAMILCACHE_PORT=8484
# Image to run. Pin a tag to control when you update: latest | 1.2 | sha-<short>.
TAMILCACHE_IMAGE=ghcr.io/electr0de/tamilcache:latest
# Owner of the files in TAMILCACHE_DATA. Unraid: 99/100 (nobody:users) — the default.
# Any other Linux host: your own ids, e.g. PUID=$(id -u) / PGID=$(id -g).
PUID=99
PGID=100
UMASK=002
# DELTA_CRON is a local-time spec, so the zone matters: without TZ the container runs in UTC and
# "0 3 * * *" fires at 08:30 IST.
TZ=UTC

# ─── app ─────────────────────────────────────────────────────────────────────────────────────────
# Only needed when running outside the container (dev). Compose sets both to /data.
# PORT=8484
# HOST=127.0.0.1
# DB_PATH=./data/tamilcache.db
# DATA_DIR=./data

# loopback | true | false. `true` exposes the generated key to any client that can reach the port;
# `false` means the key only comes from the logs / Settings.
ALLOW_BOOTSTRAP=loopback

# Recommended: Hindi-original detection and episode coverage. Free key from
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional, manual-only fallbacks for titles TMDB does not have. The worker never calls either;
# they are used from the review queue, on an explicit click. Leave blank to hide their panels.
# OMDb free tier: 1,000 requests/day (https://www.omdbapi.com/apikey.aspx). The key needs its
# activation email clicked before it answers; until then the route returns 502.
OMDB_API_KEY=
# TVDB v4, shows only. Free keys are issued to individuals; attribution to TheTVDB.com is required
# wherever its data is displayed (https://thetvdb.com/api-information).
TVDB_API_KEY=
# Only if the key was issued with a PIN (project keys); account keys log in with the key alone.
TVDB_PIN=

# Optional. Leave blank and the app generates a key on first start, stores it in the database,
# shows it on the Settings page and logs it once. Set it only to pin your own.
TORZNAB_API_KEY=

# Leave at 2000. Lowering it makes the site answer 403 and trips the circuit breaker.
CRAWL_DELAY_MS=2000
CRAWL_CONCURRENCY=1
DELTA_CRON=0 3 * * *
# The backfill is started from the Dashboard on purpose; this only controls headless behaviour.
BACKFILL_ENABLED=false
BACKFILL_PAGES_PER_TICK=2
BEST_VARIANT_ONLY=false
SEASON_PACK_EXPANSION=false
LOG_LEVEL=info
LOG_KEEP_DAYS=14
MIRRORS=www.1tamilmv.io,www.1tamilmv.style,www.1tamilmv.fi,1tamilmv.meme,1tamilmv.observer
